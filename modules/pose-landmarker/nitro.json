{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["arpose"],
  "ios": {
    "iosModuleName": "ARPoseLandmarker"
  },
  "android": {
    "androidNamespace": ["arpose"],
    "androidCxxLibName": "ARPoseLandmarker"
  },
  "autolinking": {
    "PoseDetectorFactory": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPoseDetectorFactory"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPoseDetectorFactory"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
